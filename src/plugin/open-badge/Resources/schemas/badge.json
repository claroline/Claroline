{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "The badge id"
    },
    "image": {
      "type": ["string", "null"],
      "description": "The URL of the badge image"
    },
    "issuer": {
      "type": "object",
      "$ref": "https://github.com/claroline/Claroline/tree/master/src/main/core/Resources/schemas/organization.json"
    },
    "duration": {
      "type": "number",
      "description": "The number of days the badge is valid"
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "parameters": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string",
          "description": "A short description of the badge"
        },
        "descriptionHtml": {
          "type": "string",
          "description": "A long HTML description of the badge"
        }
      }
    }
  },
  "claroline": {
    "ids": ["id"]
  }
}
